# Textured cube for ACG path tracer
mtllib textured_cube.mtl
o TexturedCube

# Vertex positions
v -1.0 -1.0 -1.0
v  1.0 -1.0 -1.0
v  1.0  1.0 -1.0
v -1.0  1.0 -1.0
v -1.0 -1.0  1.0
v  1.0 -1.0  1.0
v  1.0  1.0  1.0
v -1.0  1.0  1.0

# Texture coordinates
vt 0.0 0.0
vt 1.0 0.0
vt 1.0 1.0
vt 0.0 1.0

usemtl CheckerMaterial
s off

# Front face (+Z)
f 5/1 6/2 7/3
f 5/1 7/3 8/4

# Back face (-Z)
f 2/1 1/2 4/3
f 2/1 4/3 3/4

# Right face (+X)
f 6/1 2/2 3/3
f 6/1 3/3 7/4

# Left face (-X)
f 1/1 5/2 8/3
f 1/1 8/3 4/4

# Top face (+Y)
f 8/1 7/2 3/3
f 8/1 3/3 4/4

# Bottom face (-Y)
f 1/1 2/2 6/3
f 1/1 6/3 5/4
